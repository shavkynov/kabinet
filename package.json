    "test": "node -e \"const fs=require('fs'),cp=require('child_process');const f=fs.readdirSync('test').filter(x=>x.endsWith('.test.js')).sort().map(x=>'test/'+x);process.exit(cp.spawnSync(process.execPath,['--test',...f],{stdio:'inherit'}).status??1)\"",
    "check": "node scripts/check.js",
    "test:ui": "node test-ui/ui-smoke.js",
    "map": "node scripts/map.js",
    "i18n": "node scripts/i18n-scan.js"
  },
  "devDependencies": {
    "@tiptap/core": "^2.10.0",
    "@tiptap/pm": "^2.10.0",
