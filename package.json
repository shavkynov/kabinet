{
  "name": "kabinet",
  "productName": "Кабинет",
  "version": "0.36.0",
  "description": "Редактор Александра Шавкунова для писателей",
  "main": "src/electron-entry.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build && electron .",
    "test": "node scripts/test.js",
    "dist": "npm run build && electron-builder --mac dir --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win-nosign": "npm run build && electron-builder --win nsis --x64 --publish never -c.win.signAndEditExecutable=false",
    "dist:win-from-mac": "npm run build && electron-builder --win nsis --x64 --publish never -c.win.signAndEditExecutable=false",
    "dist:win-portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:dmg": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "install-app": "bash scripts/install-app.sh",
    "check": "node scripts/check.js",
    "map": "node scripts/map.js",
    "release": "bash scripts/release.sh",
    "i18n": "node scripts/i18n-scan.js",
    "installer": "bash scripts/make-installer.sh"
  },
  "devDependencies": {
    "@tiptap/core": "^2.10.0",
    "@tiptap/pm": "^2.10.0",
    "@tiptap/starter-kit": "^2.10.0",
    "electron": "^45.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "rcedit": "^3.1.0",
    "tiptap-markdown": "^0.8.10"
  },
  "author": {
    "name": "Александр Шавкунов"
  },
  "build": {
    "appId": "ru.kabinet.writer",
    "productName": "Кабинет",
    "protocols": [
      {
        "name": "Kabinet OAuth",
        "schemes": [
          "kabinet"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.js",
    "artifactName": "Kabinet-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/index.html",
      "renderer/style.css",
      "renderer/dist/app.js",
      "sounds/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon-512.png",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kabinet-${version}-linux-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1049",
      "shortcutName": "Кабинет",
      "artifactName": "Kabinet-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Kabinet-Portable-${version}.${ext}"
    },
    "dmg": {
      "title": "Кабинет ${version}"
    },
    "copyright": "Редактор Александра Шавкунова"
  }
}
