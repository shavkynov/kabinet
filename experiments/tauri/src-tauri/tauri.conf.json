{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kabinet Test",
  "version": "0.1.0",
  "identifier": "ru.kabinet.writer.test",
  "build": {
    "beforeDevCommand": "node build.cjs",
    "beforeBuildCommand": "node build.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "editor-lab",
        "title": "Кабинет Test — текст не сохраняется",
        "width": 1100,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../../build/icon.png",
      "../../../build/icon.ico"
    ]
  }
}
