{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Кабинет (Tauri, тест)",
  "version": "0.38.0",
  "identifier": "ru.kabinet.writer.tauri",
  "build": {
    "beforeDevCommand": "node build.cjs",
    "beforeBuildCommand": "node build.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Кабинет",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../../build/icon.png",
      "../../../build/icon.ico",
      "../../../build/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Редактор Кабинет",
    "longDescription": "Кабинет — редактор для писателей: рукопись, карточки, проверка текста, резервные копии и Яндекс Диск.",
    "copyright": "© Александр Шавкунов",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "kabinet"
        ]
      }
    }
  }
}
